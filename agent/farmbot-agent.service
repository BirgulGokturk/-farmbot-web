# DİKKAT: Bu dosya UTF-8 (BOM'suz) ve LF satır sonlarıyla kaydedilmelidir.
#
# systemd, dosyanın başındaki BOM yüzünden `[Unit]` satırını bölüm başlığı
# saymıyor ve altındaki her satır için "Assignment outside of section" deyip
# yok sayıyor. Windows'ta düzenlerken editörünüzün bunu bozmadığından emin
# olun; en güvenlisi dosyayı Pi'nin kendi kabuğunda oluşturmak.
#
# TOKEN BURADA DEĞİL
# ------------------
# Cihaz token'ı ayrı bir dosyada tutuluyor ve dosya **ajanın kendi
# yazabildiği** bir yerde duruyor (~/.config/farmbot/agent.env).
#
# İki şeyi mümkün kılıyor:
#   * Eşleştirme: `farmbot_agent.py --esles ABCD-1234` token'ı alıp oraya
#     kendisi yazıyor; 56 karakterlik diziyi elle taşımak gerekmiyor.
#   * Otomatik yenileme: ajan token eskiyince yenisini alıp aynı dosyaya
#     yazıyor, insan eli değmiyor.
#
# Eskiden token bu birim dosyasının içindeydi ve her yenileme onu baştan
# yazmayı gerektiriyordu; bir kez CRLF ile kaydedildiğinde token'ın sonuna
# görünmez bir karakter yapışıp anlaşılması bir gün süren bir 403'e
# dönüşüyordu.

[Unit]
Description=FarmBot köprü ajanı (Arduino -> bulut)
# Ağ hazır olmadan başlarsa ilk gönderimler tampona düşer; beklemek daha temiz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- DÜZENLEYİN: kendi kullanıcı adınız ve dizininiz ---
User=pi
WorkingDirectory=/home/pi/farmbot-web/agent
ExecStart=/home/pi/farmbot-web/agent/.venv/bin/python farmbot_agent.py
# -------------------------------------------------------

Environment=FARMBOT_SERIAL_PORT=/dev/ttyUSB0
Environment=FARMBOT_BAUD=9600
Environment=FARMBOT_GANTRY_URL=http://localhost:8091
Environment=FARMBOT_API_URL=https://farmbot-api.onrender.com

# Token buradan okunuyor. Baştaki `-` "dosya yoksa görmezden gel" demek:
# henüz eşleşmemiş bir kurulumda servis yine de açılsın ve günlüğe nasıl
# eşleşileceğini yazsın — açılmayan bir servisin sebebini bulmak daha zor.
#
# DÜZENLEYİN: `pi` yerine kendi kullanıcı adınız.
EnvironmentFile=-/home/pi/.config/farmbot/agent.env

# Ajan çökerse ya da Arduino çıkarılırsa kendiliğinden toparlansın
Restart=always
RestartSec=5

# Günlükler journalctl'e düşsün
StandardOutput=journal
StandardError=journal
SyslogIdentifier=farmbot-agent

[Install]
WantedBy=multi-user.target
