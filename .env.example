# ----------------------------------------------------------------------------
# Bu dosyayı `.env` olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
#   cp .env.example .env
# ----------------------------------------------------------------------------

# --- Genel ---
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# --- Veritabanı ---
# Docker Compose ile: host adı `db` servisinin adıdır
DATABASE_URL=postgresql+asyncpg://farmbot:farmbot@db:5432/farmbot
# Docker'sız hızlı deneme için:
# DATABASE_URL=sqlite+aiosqlite:///./farmbot.db
DB_ECHO=false

POSTGRES_USER=farmbot
POSTGRES_PASSWORD=farmbot
POSTGRES_DB=farmbot

# --- Güvenlik ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gelistirme-icin-guvensiz-anahtar-uretimde-mutlaka-degistir
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (virgülle ayrılmış) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MQTT (robot haberleşmesi) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_ENABLED=true
RPC_TIMEOUT_SECONDS=15

# --- Medya ---
MEDIA_ROOT=./media

# --- Başlangıç verisi ---
SEED_DEMO_DATA=true

# --- Ön yüz (Vite build zamanında okur) ---
# Boş bırakılırsa aynı origin üzerinden /api/v1 kullanılır (vekil sunucu).
# Ayrı alan adlarına dağıtırken doldurun:
# VITE_API_URL=https://api.ornek.com/api/v1
# VITE_WS_URL=wss://api.ornek.com/api/v1/ws
